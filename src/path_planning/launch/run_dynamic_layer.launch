<launch>
  <!-- Arguments -->
  <arg name="map_file" default="corridor" />
  <arg name="cmd_vel_topic" default="/cmd_vel" />
  <arg name="odom_topic" default="odom" />
  <arg name="move_forward_only" default="false"/>
  <arg name="use_dummy_obstacles" default="true"/>

  <!-- Map Server -->
  <node name="map_server" pkg="map_server" type="map_server" 
    args="$(find path_planning)/maps/$(arg map_file)/$(arg map_file).yaml" />

  <!-- move_base -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="dwa_controller/DWAController" />
    
    <!-- Load common params for both global and local costmaps -->
    <rosparam file="$(find path_planning)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find path_planning)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    
    <!-- Load specific params -->
    <!-- Use the NEW dynamic params file here -->
    <rosparam file="$(find path_planning)/config/local_costmap_dynamic_params.yaml" command="load" />
    <rosparam file="$(find path_planning)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find path_planning)/config/move_base_params.yaml" command="load" />
    
    <!-- Remap topics -->
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
  </node>

  <node name="dummy_obs" pkg="path_planning" type="test_dynamic_obstacles.py" output="screen" if="$(arg use_dummy_obstacles)"/>

  <!-- Rviz -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find path_planning)/rviz/mapping.rviz" />

  <!-- Static TF for testing (if not provided by simulation/robot) -->
  <!-- map -> odom -> base_link -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="map_odom_broadcaster" args="0 0 0 0 0 0 map odom" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="odom_base_link_broadcaster" args="0 0 0 0 0 0 odom base_link" />

</launch>
