<?xml version="1.0"?>
<launch>
    <!-- <env name="ROSCONSOLE_CONFIG_FILE" value="$(find umap)/config/rosconsole.config"/> -->
    
    <!-- Load parameters -->
    <rosparam command="load" file="$(find umap)/config/test_clean.yaml" />
    <param name="use_sim_time" value="true" />

    <!-- Launch main node -->
    <node pkg="umap" type="coarse_match" name="coarse_match_tracker" output="screen" />
</launch>
