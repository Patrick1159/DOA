<launch>
    <!-- ========== Arguments ========== -->
    <arg name="rgb_topic" default="/camera/rgb/image_raw" />
    <arg name="depth_topic" default="/camera/depth/image_raw" />
    <arg name="aligned_depth_topic" default="/camera/depth/image_raw" />
    
    <!-- ========== Parameters ========== -->
    <rosparam command="load" file="$(find umap)/config/umap_params.yaml" />
    
    <!-- ========== UMAP Processing Nodes ========== -->
    <node pkg="umap" type="umap_extract" name="umap_node" output="screen">
        <param name="image_topic" value="$(arg rgb_topic)" />
        <remap from="/camera/aligned_depth_to_color/image_raw" to="$(arg aligned_depth_topic)" />
        <remap from="/camera/color/image_raw" to="$(arg rgb_topic)" />
    </node>
    
    <node pkg="umap" type="static_transform_node" name="static_transform_node" output="screen" />
    
    <!-- ========== Matching Nodes ========== -->
    <node pkg="umap" type="coarse_match" name="coarse_match_tracker" output="screen">
        <param name="image_topic" value="$(arg rgb_topic)" />
    </node>
    
    <node pkg="umap" type="rematch" name="detailed_match_tracker" output="screen">
        <param name="image_topic" value="$(arg rgb_topic)" />
    </node>
    
    <!-- ========== Point Cloud Processing ========== -->
    <node name="static_pose_tf" pkg="pointcloud_generator" type="static_pose_tf.py" output="screen">
        <param name="parent_frame_id" value="base_link" />
        <param name="child_frame_id" value="camera_rgb_optical_frame" />
    </node>

    <node name="camera_node" pkg="pointcloud_generator" type="processor" output="screen">
        <rosparam file="$(find pointcloud_generator)/param/sim_param.yaml" command="load"/>
        <param name="frame_id" value="base_link" />

        <!-- <remap from="/RED/pointcloud_process/pointcloud" to="/your_pc_name"/> -->
        <remap from="/RED/pointcloud_process/camera_pose" to="/camera/current_pose"/>
        <remap from="/RED/pointcloud_process/odom" to="/uav0/mavros/local_position/odom"/>
        <remap from="/RED/pointcloud_process/color_image" to="/camera/rgb/image_raw"/>
        <remap from="/RED/pointcloud_process/depth_image" to="/camera/depth/image_raw"/>
        <remap from="/model_output/obstacles" to="/model_output/obstacles"/>
    </node>

    <!-- ========== Feature Processing ========== -->
    <node pkg="umap" type="feature_extract.py" name="feature_extractor" output="screen">
        <param name="image_topic" value="$(arg rgb_topic)" />
    </node>
    
    <!-- ========== Visualization ========== -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find umap)/rviz/umap_config.rviz" />

</launch>
