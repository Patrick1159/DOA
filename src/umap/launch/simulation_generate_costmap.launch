<launch>
    <arg name="map_file" default="corridor" />
<!-- 
    <node name="real_baselink_publisher" pkg="umap" type="t265_baselink.py" output="screen">
        <param name="source_frame" value="camera_depth_frame" />
        <param name="target_frame" value="odom" />
        <param name="output_frame" value="real_baselink" />
        <param name="k_init_frames" value="10" />
    </node> -->
    <!-- <node pkg="tf" 
        type="static_transform_publisher" 
        name="realsense_t265_to_d400" 
        args="0 0 0.0 0 0.0 0 /real_baselink /d400_link 100"/> -->
    <!-- <node name="map_server" pkg="map_server" type="map_server" 
        args="$(find path_planning)/maps/$(arg map_file)/$(arg map_file).yaml" /> -->

    <node name="costmap_generator" pkg="umap" type="costmap_generator" output="screen">
        <!-- Costmap parameters -->
        <param name="simulation" value="true" />
        <param name="resolution" value="0.05" />        <!-- 5cm resolution -->
        <param name="map_width" value="20.0" />         <!-- 20m x 20m map -->
        <param name="map_height" value="20.0" />
        <param name="robot_height" value="2.0" />       <!-- Consider obstacles up to 2m -->
        <param name="obstacle_threshold" value="0.1" /> <!-- Points above 10cm are obstacles -->
        <param name="free_threshold" value="0.02" />    <!-- Points below 2cm are free space -->
        <param name="reach_tolerance" value="0.5" /> 
        <param name="age_tolerance" value="0.2" />    <!-- Ignore obstacles older than 2 seconds -->
        <param name="t_pred" value="5.0" />              <!-- Predict 1 second into the future -->
        <param name="eps" value="0.5" />              <!-- Dynamic Obstacle shape Modeling (circle)  -->
        <param name="vel_uncertainty_rate" value="10.0" />

        <!-- Frame parameters -->
        <param name="map_frame" value="map" />
        <param name="pointcloud_frame" value="camera_rgb_optical_frame" />
        
        <!-- Topic remapping if needed -->
        <remap from="/velodyne_points" to="/RED/pointcloud_process/pointcloud" />
        <remap from="/costmap" to="/move_base/global_costmap/costmap" />
    </node>

    <!-- tf from map to world -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="t265_link_to_base_link" 
          args="0 0 0 0 -0.403598333 0 t265_link base_link" /> -->
    <!-- <node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="0 0 0 1.57 0 0 map odom 100" /> -->
</launch>